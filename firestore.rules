rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function member(event) { return signed() && exists(/databases/$(database)/documents/events/$(event)/memberships/$(request.auth.uid)); }
    function role(event) { return get(/databases/$(database)/documents/events/$(event)/memberships/$(request.auth.uid)).data.role; }
    function admin(event) { return member(event) && role(event) == 'admin'; }
    function reader(event) { return member(event) && role(event) in ['admin','member','viewer']; }
    function validTask(event) {
      let d = request.resource.data;
      return d.keys().hasOnly(['title','status','progress','dueDate','priority','nextAction','assigneeIds','archived','revision','eventId','createdBy','createdAt','updatedBy','updatedAt'])
        && d.keys().hasAll(['title','status','progress','dueDate','priority','nextAction','assigneeIds','archived','revision','eventId','createdBy','createdAt','updatedBy','updatedAt'])
        && d.eventId == event && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.status in ['未着手','対応中','確認待ち','承認待ち','完了','保留']
        && d.progress is int && d.progress >= 0 && ((d.status == '完了' && d.progress == 100) || (d.status != '完了' && d.progress < 100))
        && d.dueDate is string && d.dueDate.size() <= 10 && d.priority in ['最優先','高','中','低']
        && d.nextAction is string && d.nextAction.size() <= 4000 && d.assigneeIds is list && d.assigneeIds.size() <= 30
        && d.archived is bool && d.revision is int && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function validStage(event) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','date','confidence','details','revision','eventId','createdBy','createdAt','updatedBy','updatedAt'])
        && d.keys().hasAll(['name','date','confidence','details','revision','eventId','createdBy','createdAt','updatedBy','updatedAt'])
        && d.eventId == event && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.date is string && d.date.size() <= 10 && d.confidence in ['確定','予定','未確定']
        && d.details is string && d.details.size() <= 4000 && d.revision is int
        && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function validDecision(event) {
      let d = request.resource.data;
      return d.keys().hasOnly(['title','details','status','resolution','revision','logId','eventId','createdBy','createdAt','updatedBy','updatedAt']) && d.keys().hasAll(['title','details','status','resolution','revision','logId','eventId','createdBy','createdAt','updatedBy','updatedAt'])
      && d.eventId == event && d.title is string && d.title.size() > 0 && d.title.size() <= 200 && d.details is string && d.details.size() <= 4000
      && d.status in ['未確定','決定済み'] && d.resolution is string && d.resolution.size() <= 4000 && d.logId is string && d.revision is int && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    function validPublication(event) {
      let d = request.resource.data;
      return d.keys().hasOnly(['eventId','title','body','category','certainty','releaseAt','status','revision','createdBy','createdAt','updatedBy','updatedAt'])
        && d.keys().hasAll(['eventId','title','body','category','certainty','releaseAt','status','revision','createdBy','createdAt','updatedBy','updatedAt'])
        && d.eventId == event && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.body is string && d.body.size() <= 10000 && d.category in ['お知らせ','大会日程','大会ルール','募集案内','賞品']
        && d.certainty in ['確定','予定','未確定'] && d.releaseAt is timestamp && d.status in ['下書き','承認済み','公開済み']
        && d.revision is int && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    match /events/{event} {
      allow read: if reader(event);
      allow write: if false;
      match /memberships/{uid} {
        allow get: if signed() && request.auth.uid == uid;
        allow list, write: if false;
      }
      match /publications/{publication} {
        allow read: if reader(event);
        allow create: if admin(event) && validPublication(event) && request.resource.data.status == '下書き' && request.resource.data.revision == 1 && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update: if admin(event) && validPublication(event) && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
          && ((resource.data.status in ['下書き','承認済み'] && request.resource.data.status == '下書き')
          || (resource.data.status == '下書き' && request.resource.data.status == '承認済み' && resource.data.certainty == '確定' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revision','updatedBy','updatedAt']))
          || (resource.data.status == '承認済み' && request.resource.data.status == '公開済み' && resource.data.certainty == '確定' && resource.data.releaseAt <= request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revision','updatedBy','updatedAt']) && !exists(/databases/$(database)/documents/publicEvents/$(event)/announcements/$(publication)) && existsAfter(/databases/$(database)/documents/publicEvents/$(event)/announcements/$(publication)))
          || (resource.data.status == '公開済み' && request.resource.data.status == '下書き' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revision','updatedBy','updatedAt']) && !existsAfter(/databases/$(database)/documents/publicEvents/$(event)/announcements/$(publication))));
        allow delete: if false;
      }
      match /decisions/{decision} {
        allow read: if reader(event);
        allow create: if admin(event) && validDecision(event) && request.resource.data.revision == 1 && request.resource.data.status == '未確定' && request.resource.data.logId == '' && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update: if admin(event) && validDecision(event) && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
          && ((resource.data.status == '未確定' && request.resource.data.status == '未確定' && request.resource.data.logId == '')
          || (resource.data.status == '未確定' && request.resource.data.status == '決定済み' && request.resource.data.resolution.size() > 0 && request.resource.data.logId.size() > 0 && getAfter(/databases/$(database)/documents/events/$(event)/decisionLogs/$(request.resource.data.logId)).data.decisionId == decision && getAfter(/databases/$(database)/documents/events/$(event)/decisionLogs/$(request.resource.data.logId)).data.resolution == request.resource.data.resolution)
          || (resource.data.status == '決定済み' && request.resource.data.status == '決定済み' && request.resource.data.resolution == resource.data.resolution && request.resource.data.logId == resource.data.logId));
        allow delete: if false;
      }
      match /decisionLogs/{log} {
        allow read: if reader(event);
        allow create: if admin(event) && request.resource.data.keys().hasOnly(['eventId','decisionId','title','resolution','decidedBy','decidedAt']) && request.resource.data.keys().hasAll(['eventId','decisionId','title','resolution','decidedBy','decidedAt'])
          && request.resource.data.eventId == event && request.resource.data.decisionId is string && request.resource.data.title is string && request.resource.data.resolution is string && request.resource.data.decidedBy == request.auth.uid && request.resource.data.decidedAt == request.time
          && get(/databases/$(database)/documents/events/$(event)/decisions/$(request.resource.data.decisionId)).data.status == '未確定'
          && getAfter(/databases/$(database)/documents/events/$(event)/decisions/$(request.resource.data.decisionId)).data.logId == log
          && getAfter(/databases/$(database)/documents/events/$(event)/decisions/$(request.resource.data.decisionId)).data.status == '決定済み'
          && getAfter(/databases/$(database)/documents/events/$(event)/decisions/$(request.resource.data.decisionId)).data.resolution == request.resource.data.resolution;
        allow update, delete: if false;
      }
      match /weeklySnapshots/{snapshot} {
        allow read: if reader(event);
        allow create: if admin(event) && request.resource.data.keys().hasOnly(['eventId','label','data','comment','createdBy','createdAt'])
          && request.resource.data.keys().hasAll(['eventId','label','data','comment','createdBy','createdAt'])
          && request.resource.data.eventId == event && request.resource.data.label is string && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 100
          && request.resource.data.data is string && request.resource.data.data.size() <= 700000
          && request.resource.data.comment is string && request.resource.data.comment.size() <= 4000
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /stages/{stage} {
        allow read: if reader(event);
        allow create, update: if admin(event) && validStage(event)
          && ((resource == null && request.resource.data.revision == 1 && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time)
           || (resource != null && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt));
        allow delete: if false;
      }
      match /tasks/{task} {
        allow read: if reader(event);
        allow create: if admin(event) && validTask(event) && request.resource.data.revision == 1 && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update: if validTask(event) && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
          && (admin(event) || (member(event) && role(event) == 'member' && request.auth.uid in resource.data.assigneeIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','progress','nextAction','revision','updatedBy','updatedAt'])));
        allow delete: if false;
      }
    }
    match /publicEvents/{event}/announcements/{publication} {
      allow read: if true;
      allow create: if admin(event) && request.resource.data.keys().hasOnly(['eventId','title','body','category','publishedAt']) && request.resource.data.keys().hasAll(['eventId','title','body','category','publishedAt'])
        && request.resource.data.eventId == event && request.resource.data.publishedAt == request.time
        && get(/databases/$(database)/documents/events/$(event)/publications/$(publication)).data.status == '承認済み'
        && get(/databases/$(database)/documents/events/$(event)/publications/$(publication)).data.certainty == '確定'
        && get(/databases/$(database)/documents/events/$(event)/publications/$(publication)).data.releaseAt <= request.time
        && getAfter(/databases/$(database)/documents/events/$(event)/publications/$(publication)).data.status == '公開済み'
        && request.resource.data.title == getAfter(/databases/$(database)/documents/events/$(event)/publications/$(publication)).data.title
        && request.resource.data.body == getAfter(/databases/$(database)/documents/events/$(event)/publications/$(publication)).data.body
        && request.resource.data.category == getAfter(/databases/$(database)/documents/events/$(event)/publications/$(publication)).data.category;
      allow update: if false;
      allow delete: if admin(event) && get(/databases/$(database)/documents/events/$(event)/publications/$(publication)).data.status == '公開済み' && getAfter(/databases/$(database)/documents/events/$(event)/publications/$(publication)).data.status == '下書き';
    }
    match /{document=**} { allow read, write: if false; }
  }
}
